# Copy this file to .env and fill in the keys you have.

# AI steps in Module 3 (config llm.provider). Without the key, Module 3 runs on rules only.
GROQ_API_KEY=
ANTHROPIC_API_KEY=

# Optional, free: https://api.data.gov/signup/  (cross-checks official websites in Module 1)
SCORECARD_API_KEY=

# Google searches for Modules 1-3 (https://serper.dev - 2,500 free searches, then about $1 per 1,000).
# One key, or several separated by commas: they are used one by one, moving to the next when a key runs out.
# Without a key, searches go through Chrome (slow, CAPTCHAs).
SERPER_API_KEYS=
