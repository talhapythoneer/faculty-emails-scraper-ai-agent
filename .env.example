# API keys for the Faculty Emails Extractor.
# setup.bat copies this file to .env - put your keys in .env (never share that file).

# Google search for all modules - https://serper.dev (2,500 free searches at sign-up, then about $1 per 1,000).
# One key, or several separated by commas: they are used in order, moving to the next when one runs out.
# Without a key, searches go through the Chrome window (much slower, with CAPTCHAs).
SERPER_API_KEYS=

# AI steps in Module 3 - https://console.groq.com (model openai/gpt-oss-120b, about $2-4 for 300 institutions).
# Without a key, Module 3 runs on rules only (fewer majors and contacts).
GROQ_API_KEY=

# Optional: use Claude instead of Groq (set llm.provider: anthropic in config.yaml).
ANTHROPIC_API_KEY=

# Optional, free: https://api.data.gov/signup/ - cross-checks official websites in Module 1.
SCORECARD_API_KEY=
